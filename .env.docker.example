COMPOSE_PROJECT_NAME=chefbe

APP_ENV=production
APP_URL=https://www.chef-be.fr
HOST_BIND_IP=127.0.0.1
APP_HTTP_PORT=8080
APP_HTTPS_PORT=8443
APP_UID=10000
APP_GID=1003

DB_ROOT_PASSWORD=change-me-root
DB_NAME=chefbe
DB_USER=chefbe
DB_PASSWORD=change-me-db
DB_PORT=3306
DB_BOOTSTRAP_SQL=

REDIS_PORT=6379

NODEJS_PORT=3000

CHEF_LIVE_API_PORT=8081
CHEF_LIVE_RTMP_PORT=1935
CHEF_LIVE_HLS_PORT=8088
CHEF_LIVE_WEBRTC_PORT=8889
CHEF_LIVE_RTP_PORT=10000

LIVE_PROVIDER=chef_live
AGORA_ENABLED=1
CHEF_LIVE_ENABLED=1

S3_ENABLED=0
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

TLS_CERT_PATH=./nodejs/chef-be.pem
TLS_KEY_PATH=./nodejs/chef-be.key
SITE_ENCRYPT_KEY=
